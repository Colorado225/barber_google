{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test database/tests/*.test.mjs tests/*.test.mjs && node --import tsx --test tests/*.test.tsx",
    "test:tenant": "node --test database/tests/tenant.test.mjs",
    "test:workflow": "node --test database/tests/workflow.test.mjs",
    "test:resources": "node --test database/tests/resources.test.mjs",
    "test:supabase": "node --test database/tests/supabase-core.test.mjs database/tests/supabase-branch-hours.test.mjs database/tests/supabase-operations.test.mjs database/tests/supabase-finance.test.mjs database/tests/supabase-marketplace.test.mjs database/tests/supabase-walk-in.test.mjs database/tests/supabase-client-journey.test.mjs",
    "test:walk-in": "node --test database/tests/supabase-walk-in.test.mjs",
    "test:finance": "node --test database/tests/supabase-finance.test.mjs",
    "test:api": "node --test tests/api.test.mjs",
    "test:operations": "node --test tests/operations-lot3.test.mjs",
    "test:operations:pg": "node --test tests/operations-lot3.pg.test.mjs",
    "test:marketplace": "node --import tsx --test tests/marketplace-navigation.test.tsx",
    "test:onboarding": "node --import tsx --test tests/business-onboarding.test.tsx",
    "supabase:db:reset": "supabase db reset",
    "supabase:db:linked:status": "supabase migration list --linked",
    "supabase:db:linked:preview": "supabase db push --linked --dry-run",
    "supabase:db:linked:push": "supabase db push --linked",
    "dev:auth": "node server/index.js",
    "test:auth": "node --test tests/auth.test.mjs",
    "test:journey": "node --test database/tests/supabase-client-journey.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.5",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
