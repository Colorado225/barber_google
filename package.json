{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node scripts/prerender-public.mjs",
    "preview": "vite preview",
    "perf:check": "node scripts/measure-bundles.mjs --throttle-check",
    "perf:report": "node scripts/measure-bundles.mjs --throttle-check --report reports/bundle-metrics.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test database/tests/*.test.mjs tests/*.test.mjs && node --import tsx --test tests/*.test.tsx",
    "test:supabase": "node --test database/tests/supabase-core.test.mjs database/tests/supabase-branch-hours.test.mjs database/tests/supabase-operations.test.mjs database/tests/supabase-finance.test.mjs database/tests/supabase-marketplace.test.mjs database/tests/supabase-walk-in.test.mjs database/tests/supabase-client-journey.test.mjs database/tests/supabase-marketplace-customizer.test.mjs database/tests/supabase-security.test.mjs",
    "test:walk-in": "node --test database/tests/supabase-walk-in.test.mjs",
    "test:finance": "node --test database/tests/supabase-finance.test.mjs",
    "test:marketplace": "node --import tsx --test tests/marketplace-navigation.test.tsx",
    "test:onboarding": "node --import tsx --test tests/business-onboarding.test.tsx",
    "supabase:db:reset": "supabase db reset",
    "supabase:db:linked:status": "supabase migration list --linked",
    "supabase:db:linked:preview": "supabase db push --linked --dry-run",
    "supabase:db:linked:push": "supabase db push --linked",
    "test:journey": "node --test database/tests/supabase-client-journey.test.mjs",
    "test:security": "node --test database/tests/supabase-security.test.mjs && node --import tsx --test tests/permissions-parity.test.tsx tests/permissions.test.tsx"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/google.maps": "^3.66.10",
    "@vis.gl/react-google-maps": "^1.10.2",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.5",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
